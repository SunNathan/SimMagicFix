#include <windows.h>
#include "resource.h"

IDI_APP_ICON  ICON "app.ico"
IDI_TRAY_ICON ICON "tray.ico"

1 VERSIONINFO
FILEVERSION     0,4,0,0
PRODUCTVERSION  0,4,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "SimagicFix (community)"
            VALUE "FileDescription",  "SimagicFix - LMU telemetry hook for SimPro"
            VALUE "FileVersion",      "0.4.0.0"
            VALUE "InternalName",     "SimagicFix"
            VALUE "LegalCopyright",   "Unofficial community tool - not affiliated with Simagic"
            VALUE "OriginalFilename", "SimagicFix.exe"
            VALUE "ProductName",      "SimagicFix"
            VALUE "ProductVersion",   "0.4.0.0"
            VALUE "Comments",         "Original community icon inspired by Simagic colours"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
